{
 "_about": "RS-3 (tour, P1): Open full workspace from the companion's arrow; the workspace fills most of the screen. Checked 31 Oct: the workspace is first folded into the pebble (⌘K, Switch to the floating companion), then the take clicks the pebble and the quick chat's 'Open full workspace'.",
 "schema": "pebble-take-job/1",
 "id": "RS3-$n",
 "take": "RS-3",
 "title": "Open full workspace",
 "steps": [
  {
   "do": "key",
   "key": "space",
   "mods": [
    "cmd",
    "shift"
   ],
   "note": "the workspace forward"
  },
  {
   "do": "wait",
   "s": 2
  },
  {
   "do": "find",
   "app": "Pebble",
   "role": "AXButton",
   "name": "Companion",
   "window_contains": "Pebble",
   "save_as": "@comp",
   "timeout_s": 15,
   "budget_ms": 15000
  },
  {
   "do": "click",
   "at": "@comp",
   "note": "the clean Companion conversation, so no usage line is in view"
  },
  {
   "do": "wait",
   "s": 1.2
  },
  {
   "do": "activate",
   "app": "Pebble"
  },
  {
   "do": "wait",
   "s": 1
  },
  {
   "do": "key",
   "key": "k",
   "mods": [
    "cmd"
   ]
  },
  {
   "do": "wait",
   "s": 0.8
  },
  {
   "do": "type",
   "text": "floating"
  },
  {
   "do": "wait",
   "s": 0.8
  },
  {
   "do": "key",
   "key": "return",
   "note": "Switch to the floating companion: the workspace folds into the pebble"
  },
  {
   "do": "wait",
   "s": 2.5
  },
  {
   "do": "move",
   "to": {
    "x": 1150,
    "y": 700
   },
   "ms": 300
  },
  {
   "do": "record_start",
   "name": "RS3-$n",
   "max_s": 40,
   "method": "avfoundation"
  },
  {
   "do": "wait",
   "s": 3.5,
   "note": "pre-roll: avfoundation's first ~0.35 s repeat a stale frame (RS1-02), so the first pointer move (the conform's sync) comes after the picture is live"
  },
  {
   "do": "click",
   "at": "$stone",
   "event": "openChat"
  },
  {
   "do": "wait",
   "s": 1
  },
  {
   "do": "find",
   "app": "Pebble",
   "name": "Open full workspace",
   "save_as": "@arrow",
   "timeout_s": 15,
   "budget_ms": 15000,
   "role": "AXButton",
   "window_contains": "companion"
  },
  {
   "do": "click",
   "at": "@arrow",
   "event": "arrow"
  },
  {
   "do": "wait",
   "s": 4
  },
  {
   "do": "still",
   "name": "workspace"
  },
  {
   "do": "wait",
   "s": 3
  },
  {
   "do": "record_stop"
  },
  {
   "do": "conform",
   "name": "RS3-$n"
  }
 ]
}
