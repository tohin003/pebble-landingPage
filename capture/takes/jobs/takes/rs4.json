{
 "_about": "RS-4 (S11, P0): 'What's 48 × 12.5? Use Calculator.' in a new quick-chat conversation; the window card's Allow (exact name, never Always allow); Pebble presses the keys; the display reads 600; the reply. Checked 31 Oct: the quick chat must already be open (its 'New conversation' button is pressed before the take rolls); the message goes into 'Message Pebble'. If no button named exactly 'Allow' appears, the take records what came and dumps the tree.",
 "schema": "pebble-take-job/1",
 "id": "RS4-$n",
 "take": "RS-4",
 "title": "Calculator",
 "steps": [
  {
   "do": "reset",
   "what": "calculator"
  },
  {
   "do": "open_app",
   "app": "Calculator"
  },
  {
   "do": "wait_window",
   "app": "Calculator",
   "timeout_s": 20
  },
  {
   "do": "wait",
   "s": 1.5
  },
  {
   "do": "find",
   "app": "Pebble",
   "role": "AXButton",
   "name": "New conversation",
   "window_contains": "companion",
   "save_as": "@nc",
   "timeout_s": 6
  },
  {
   "do": "click",
   "at": "@nc"
  },
  {
   "do": "wait",
   "s": 1.2
  },
  {
   "do": "find",
   "app": "Pebble",
   "role": "AXTextArea",
   "name": "Message Pebble",
   "window_contains": "companion",
   "save_as": "@msg",
   "timeout_s": 6
  },
  {
   "do": "record_start",
   "name": "RS4-$n",
   "max_s": 150,
   "method": "avfoundation"
  },
  {
   "do": "wait",
   "s": 3.5,
   "note": "pre-roll: the picture is live before the first pointer move (the conform's sync)"
  },
  {
   "do": "click",
   "at": "@msg",
   "event": "composer"
  },
  {
   "do": "wait",
   "s": 0.6
  },
  {
   "do": "type",
   "text": "What's 48 × 12.5? Use Calculator.",
   "event": "typed"
  },
  {
   "do": "wait",
   "s": 0.4
  },
  {
   "do": "key",
   "key": "return",
   "event": "send"
  },
  {
   "do": "wait_element",
   "app": "Pebble",
   "role": "AXButton",
   "name": "Allow",
   "timeout_s": 60,
   "save_as": "@allow",
   "event": "card",
   "optional": true
  },
  {
   "do": "ax_dump",
   "app": "Pebble",
   "max": 1500,
   "name": "at-card"
  },
  {
   "do": "wait",
   "s": 1.2,
   "if": "@allow",
   "note": "the person reads the card"
  },
  {
   "do": "click",
   "at": "@allow",
   "if": "@allow",
   "event": "allow"
  },
  {
   "do": "wait_element",
   "app": "Calculator",
   "contains": "600",
   "timeout_s": 60,
   "event": "equals600",
   "optional": true,
   "save_as": "@six"
  },
  {
   "do": "wait",
   "s": 10,
   "note": "the receipt and the reply"
  },
  {
   "do": "still",
   "name": "calc-600"
  },
  {
   "do": "ax_dump",
   "app": "Pebble",
   "max": 1500,
   "name": "after"
  },
  {
   "do": "wait",
   "s": 3
  },
  {
   "do": "record_stop"
  },
  {
   "do": "conform",
   "name": "RS4-$n"
  }
 ]
}
