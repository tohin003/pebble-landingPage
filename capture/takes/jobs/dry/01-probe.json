  },
  {
   "do": "pointer"
  },
  {
   "do": "still",
   "name": "desktop"
  },
  {
   "do": "ax_dump",
   "app": "Dock",
   "max": 400,
   "name": "dock"
  },
  {
   "do": "ax_dump",
   "app": "Pebble",
   "max": 2500,
