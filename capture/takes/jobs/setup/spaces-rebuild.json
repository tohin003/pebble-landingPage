{
 "_about": "Rebuilds the Spaces as Desktop, poster, Chrome (31 Oct: Chrome had quit, its Space gone): the poster leaves full screen, then dry04's steps (Chrome full screen on the booking page first, then the poster). Ends on the poster.",
 "schema": "pebble-take-job/1",
 "id": "spaces-rebuild-$n",
 "take": "setup",
 "title": "Spaces: rebuild",
 "steps": [
  {
   "do": "activate",
   "app": "Preview"
  },
  {
   "do": "wait",
   "s": 1.5
  },
  {
   "do": "key",
   "key": "f",
   "mods": [
    "ctrl",
    "cmd"
   ],
   "note": "the poster leaves full screen"
  },
  {
   "do": "wait",
   "s": 3.5
  },
  {
   "do": "open_url",
   "url": "file:///Users/studio/Projects/studio-bookings/site/index.html",
   "app": "Google Chrome"
  },
  {
   "do": "wait_window",
   "app": "Google Chrome",
   "timeout_s": 25
  },
  {
   "do": "wait",
   "s": 2
  },
  {
   "do": "key",
   "key": "f",
   "mods": [
    "ctrl",
    "cmd"
   ],
   "note": "full screen"
  },
  {
   "do": "wait",
   "s": 3
  },
  {
   "do": "still",
   "name": "chrome-full"
  },
  {
   "do": "ax_dump",
   "app": "Google Chrome",
   "max": 400,
   "name": "chrome"
  },
  {
   "do": "open_file",
   "path": "~/Documents/Open day/poster-screen.png",
   "app": "Preview"
  },
  {
   "do": "wait_window",
   "app": "Preview",
   "title_contains": "poster-screen",
   "timeout_s": 20
  },
  {
   "do": "wait",
   "s": 2
  },
  {
   "do": "key",
   "key": "f",
   "mods": [
    "ctrl",
    "cmd"
   ]
  },
  {
   "do": "wait",
   "s": 3
  },
  {
   "do": "still",
   "name": "poster-full"
  },
  {
   "do": "key",
   "key": "right",
   "mods": [
    "ctrl"
   ],
   "note": "to Chrome's Space"
  },
  {
   "do": "wait",
   "s": 2
  },
  {
   "do": "still",
   "name": "space-3"
  },
  {
   "do": "key",
   "key": "left",
   "mods": [
    "ctrl"
   ]
  },
  {
   "do": "wait",
   "s": 2
  },
  {
   "do": "still",
   "name": "space-2"
  }
 ]
}
